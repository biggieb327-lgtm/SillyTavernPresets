# Copy this file to .env in the same folder and fill in the values.
# Lines starting with # are comments / explanations and can be left as-is or removed.

# --- Required ---
TELEGRAM_BOT_TOKEN=
NANOGPT_API_KEY=

# --- Character ---
# Filename of the SillyTavern v2 character card in this folder.
CHARACTER_CARD=nora.json

# --- Models (all optional -- sensible defaults are built in) ---
# Main chat model.
NANOGPT_MODEL=zai-org/glm-5:thinking
# Used if the chat model errors/times out/rate-limits. Leave blank to disable.
FALLBACK_MODEL=
# Model used to summarize old conversation into memory (defaults to NANOGPT_MODEL).
SUMMARY_MODEL=
# Model used to describe photos you send (must accept image input).
VISION_MODEL=
VISION_FALLBACK=
# Cheap/fast model for emoji reactions and mood appraisal.
REACTION_MODEL=zai-org/glm-4.7-flash
MOOD_MODEL=

# --- Selfies (optional) ---
# "gemini" (needs GEMINI_API_KEY) or "nanogpt". Auto-picks gemini if a key is set.
SELFIE_PROVIDER=
GEMINI_API_KEY=
# Base portrait photo for img2img selfies, placed in this folder.
SELFIE_BASE=nora_base.png

# --- Reddit link reading (optional) ---
# Free "script" app at https://www.reddit.com/prefs/apps -- requires a verified
# Reddit account. If left blank, Reddit links just get a "couldn't open" reply.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CompanionBot/1.0 by u/your_username

# --- World / location ---
WEATHER_LOCATION=Seattle
WEATHER_LAT=47.6062
WEATHER_LON=-122.3321
TIMEZONE=America/Los_Angeles

# --- Behavior toggles (1/0, also live-editable with /settings) ---
SEARCH_ENABLED=1
LINK_READING=1
REACTIONS_AUTO=1
MOOD_AUTO=1
TEXTING_REALISM=1
DEVICE_RENDER=0

# --- Heartbeat / quiet hours ---
HEARTBEAT_MIN_HOURS=2
HEARTBEAT_MAX_HOURS=6
QUIET_START=23:00
QUIET_END=08:00

# --- Payments reminders (set to 0 to disable) ---
PAYMENTS_ENABLED=1
REMINDER_TIME=09:00
REMINDER_WEEKDAY=3

# --- Scheduled jobs ---
BACKUP_WEEKDAY=6
BACKUP_TIME=09:05
REFLECTION_TIME=03:00
