# YNAB personal access token
# Generate at: https://app.ynab.com/settings/developer
YNAB_API_KEY=

# NanoGPT API key (for the Hermes model)
NANOGPT_API_KEY=

# Model to use via NanoGPT (must support tool calling)
# Check https://nano-gpt.com for available Hermes models
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Default budget name or ID (optional, skips the budget selection prompt)
# Use "last-used" to auto-select the most recently modified budget
YNAB_DEFAULT_BUDGET=last-used

# Conversation history limit (number of turns to keep in context)
MAX_HISTORY=20
