[Unit]
Description=Proactive receipt observer for bot@%i
After=bot@%i.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/default/proactive-receipt-%i
WorkingDirectory=/opt/telegram-bots/.repo/telegram-companion-bot
ExecStart=/bin/bash -lc 'journalctl -u bot@%i -f -n 0 -o cat | /usr/bin/python3 proactive_receipt_observer.py --chat-id "$OWNER_CHAT_ID" --out /opt/telegram-bots/%i/proactive-receipts.jsonl'
Restart=always
RestartSec=5

# Observation must remain isolated from the bot. This unit deliberately has no Requires=,
# BindsTo=, PartOf=, ExecStartPre/ExecStopPost systemctl calls, or shared process supervision.

[Install]
WantedBy=multi-user.target
