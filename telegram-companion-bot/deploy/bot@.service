[Unit]
Description=Telegram companion bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/telegram-bots/%i
ExecStart=/opt/telegram-bots/venv/bin/python /opt/telegram-bots/bot.py /opt/telegram-bots/%i
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
