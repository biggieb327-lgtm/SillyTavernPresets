# Copy this file to .env in the same folder and fill in the values.
# Never commit your real .env to version control.
#
# Multi-instance tip: settings shared across all your bots (NANOGPT_API_KEY, model and
# feature defaults, sampling defaults) can go in a single `common.env` next to bot.py.
# It's loaded first, then each bot's own .env overrides it — so put only what's UNIQUE to
# a character in its .env (TELEGRAM_BOT_TOKEN, CHARACTER_CARD, per-bot overrides) and keep
# the shared stuff in one place. common.env uses the same KEY=value format as this file.

# --- Required ---

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your NanoGPT API key (https://nano-gpt.com)
NANOGPT_API_KEY=your-nanogpt-api-key-here

# --- Optional: API provider ---

# Base URL for the OpenAI-compatible API (default: NanoGPT)
# Change this to use a different provider (e.g. Featherless, Together, local Ollama)
# NANOGPT_BASE=https://nano-gpt.com/api/v1

# --- Optional: model settings ---

# Model to use for chat (default shown)
# NANOGPT_MODEL=zai-org/glm-5:thinking

# Model to use for rolling summaries (can be a cheaper/faster model)
# SUMMARY_MODEL=zai-org/glm-4.7-flash

# Model for emoji reactions (fast/cheap)
# REACTION_MODEL=zai-org/glm-4.7-flash

# Model for mood appraisal (fast/cheap)
# MOOD_MODEL=zai-org/glm-4.7-flash

# Model for image vision tasks. Must support image input.
# VISION_MODEL=zai-org/glm-4.6v

# Fallback model if the primary chat model fails (5xx / timeout)
# FALLBACK_MODEL=gpt-4o-mini

# Fallback model if the vision model fails
# VISION_FALLBACK=gpt-4o

# --- Sampling knobs (optional) ---
# Applied to HER REPLIES only, not to summaries/memory/mood. Only the ones you
# uncomment are sent; anything left unset uses the model's own default. Use these
# to tune a character's voice per-instance (e.g. a hotter temperature for chaos).
# temperature and top_p work on every model; top_k / min_p / repetition_penalty
# are open-model extras NanoGPT passes through for many models (if a model rejects
# one you'll get a 400 — just comment it back out).
#
# Per-character starting points (higher temp = chaos/surprise for manic, absurd,
# scattered voices; lower = control/precision for measured, analytical ones).
# Trust your ear over the numbers — temperature behaves differently per model.
#   Jules   TEMPERATURE=1.1   TOP_P=0.95   chirp chaos, absurd swerves
#   Bonnie  TEMPERATURE=1.05  TOP_P=0.95   manic gremlin, scattered, zero-filter
#   Nora    TEMPERATURE=1.0   TOP_P=0.95   fast, fragmented, riffing but grounded
#   Priya   TEMPERATURE=0.95  TOP_P=0.92   dry wit needs precision, not chaos
#   Emily   TEMPERATURE=0.9   TOP_P=0.9    careful, literal, considered
#   Cass    TEMPERATURE=0.85  TOP_P=0.9    clinical; sharpness comes from control
#
# TEMPERATURE=1.05
# TOP_P=0.95
# TOP_K=
# MIN_P=
# FREQUENCY_PENALTY=0.3
# PRESENCE_PENALTY=0.3
# REPETITION_PENALTY=
# Max tokens per response
# MAX_TOKENS=2048

# Seconds to wait for API response before timing out
# REQUEST_TIMEOUT=300

# --- Optional: character ---

# Character card filename (must be in the bot's base directory)
# CHARACTER_CARD=nora.json

# --- Optional: selfie / image generation ---

# Which backend to use for selfie generation: "gemini" or "nanogpt"
# Defaults to "gemini" if GEMINI_API_KEY is set, otherwise "nanogpt"
# SELFIE_PROVIDER=gemini

# Google Gemini API key (for selfie generation via Gemini)
# GEMINI_API_KEY=your-gemini-key-here

# Gemini image model to use
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Reference photo filename for selfie generation (in the bot's base directory)
# SELFIE_BASE=nora_base.png

# Probability of bot sending a selfie after receiving a photo (0.0–1.0)
# PHOTO_SELFIE_CHANCE=0.20

# --- Voice: Inworld STT + TTS (INWORLD_API_KEY required for both) ---

# Base64-encoded Inworld API key. Get one at inworld.ai -- without this, voice notes will
# fail with "[couldn't make out that voice note]" and voice replies (/voice) will silently
# fail to send, the same way a bad key does for any other provider in this file.
# INWORLD_API_KEY=

# INWORLD_STT_MODEL=inworld/inworld-stt-1
# INWORLD_STT_LANG=en

# Which Inworld voice she replies with when /voice is on. List the full catalog with:
#   curl https://api.inworld.ai/voices/v1/voices -H "Authorization: Basic YOUR_KEY"
# TTS_VOICE=Sarah
# INWORLD_TTS_MODEL=inworld-tts-1.5-max

# Chance (0.0-1.0) that a reply is sent as a voice message instead of text, when /voice is on
# TTS_CHANCE=0.30

# --- Optional: voice messages ---

# Whisper model for transcribing video audio (voice notes use Inworld above, not this)
# WHISPER_MODEL=whisper-1

# Add a short note on vocal tone (pace, volume, pitch brightness, pauses) alongside the
# transcript -- local FFT analysis, no network call, no extra API key.
# VOICE_TONE_ENABLED=true

# Max video file size in MB to accept (requires ffmpeg: pkg install ffmpeg)
# VIDEO_MAX_SIZE_MB=50

# --- Optional: memory settings ---

# Max milestones to track per chat
# MILESTONES_MAX=30

# --- Semantic memory retrieval (optional, opt-in, pay-as-you-go) ---
# By default, NPC/world memories (memories.txt) are retrieved by keyword + alias
# match. Set EMBED_MODEL to a NanoGPT embedding model to instead rank them by
# meaning, so paraphrases match without exact shared words. Leave unset to keep
# the free keyword retrieval. Embeddings are pay-as-you-go on NanoGPT (cents/year
# at these volumes) — fund a small balance before enabling. If the balance runs
# dry or a call fails, retrieval automatically falls back to keyword matching.
#   BAAI/bge-large-en-v1.5  best value for English (1024d, $0.01/M)
#   BAAI/bge-m3             multilingual (handles other languages, 1024d, $0.01/M)
#   text-embedding-3-small  OpenAI, supports EMBED_DIM reduction (1536d, $0.02/M)
# EMBED_MODEL=BAAI/bge-large-en-v1.5
# Optional output-dimension reduction (text-embedding-3-* only; 0 = model default)
# EMBED_DIM=0
# Cosine-similarity floor (0–1) for a memory to count as relevant. Raise to be
# stricter (fewer, tighter matches), lower to surface more.
# EMBED_MIN_SIM=0.35

# --- Episodic recall (optional; needs EMBED_MODEL above + numpy) ---
# Archives conversation as it scrolls out of the live window and pulls the most
# relevant *past exchange* back into context per turn — verbatim recall beyond the
# rolling summary ("remember that night you told me about your dad's piano"). On by
# default when EMBED_MODEL is set; reuses the per-turn query vector, so no extra
# per-turn embedding cost. Requires numpy (pip install numpy).
# EPISODIC_RECALL=1
# Hard cap on archived chunks per bot (RAM/disk bound; ~4 KB each at 1024 dims).
# EPISODE_MAX=4000
# Messages per archived chunk (with 1 message of overlap).
# EPISODE_CHUNK_MSGS=6
# Cosine floor to surface a past moment (higher than EMBED_MIN_SIM on purpose —
# only resurface something genuinely resonant).
# EPISODE_MIN_SIM=0.40
# How many past moments to surface per turn.
# EPISODE_TOPK=1
# Don't recall anything newer than this many hours (keeps the live window from
# being echoed back).
# EPISODE_MIN_AGE_HOURS=24

# --- "On this day" reminiscing (needs EMBED_MODEL + episodic recall) ---
# Once in a while she brings up a past moment whose anniversary lands today — a month,
# six months, or a year ago ("hey, remember when..."). Reuses the episode archive, so no
# extra storage. On by default when episodic recall is on.
# ONTHISDAY_ENABLED=1
# Local time of the once-daily check.
# ONTHISDAY_TIME=10:30
# +/- days around an anniversary that still counts as a match.
# ONTHISDAY_WINDOW_DAYS=3
# Don't reminisce more often than this many days apart (keeps it special).
# ONTHISDAY_MIN_GAP_DAYS=5

# --- Reranker (optional; needs EMBED_MODEL + episodic recall) ---
# After cosine retrieval pulls candidate episodes, a cross-encoder re-scores them for a
# sharper top pick. Opt-in; falls back to cosine on any failure (so it can't break recall).
# Adds one extra off-loop call per turn, so leave it off unless you want the precision.
# RERANK_MODEL=BAAI/bge-reranker-large
# How many cosine candidates to hand the reranker.
# RERANK_CANDIDATES=12
# Endpoint path (appended to the API base). Override if your provider's route differs;
# confirm with: curl -s $BASE/rerank -H "Authorization: Bearer $KEY" -d '{...}'
# RERANK_ENDPOINT=/rerank

# --- Offline life (autonomous events in her world) ---
# A couple times a day she "lives" between conversations: a short concrete event is
# generated from her schedule/people/projects (a teammate did X, a shift went sideways)
# and stored, so she has real news to bring up and proactive check-ins aren't generic.
# No embeddings needed; uses a cheap chat model. /news shows them, /newsnow forces one.
# LIFE_SIM_ENABLED=1
# Times of day (local) to generate an event.
# LIFE_EVENT_TIMES=13:00,20:30
# How many recent events to keep.
# LIFE_EVENTS_MAX=8
# Model for generating events (cheap/fast is fine).
# LIFE_MODEL=zai-org/glm-4.7-flash

# --- Safety (distress detection) ---
# Screens each incoming message for genuine acute distress/crisis and, when found, has
# her drop the performance and respond with real care (and a crisis resource). On by
# default. Roleplay/dark humor/venting do not trigger it. Uses a cheap classifier model.
# SAFETY_ENABLED=1
# SAFETY_MODEL=zai-org/glm-4.7-flash
# The resource line she can offer (change for your country).
# SAFETY_RESOURCES=in the US, the 988 Suicide & Crisis Lifeline (call or text 988) is there 24/7

# --- Scene continuity ---
# Tracks where she physically is (location + posture) across an in-person/roleplay scene so
# she doesn't teleport (kitchen table -> couch with no transition). Updated after each
# exchange with a cheap model; returns nothing for plain abstract texting. On by default.
# SCENE_CONTINUITY=1
# SCENE_MODEL=zai-org/glm-4.7-flash
# Stop injecting the tracked scene once it's older than this many hours (a cold scene resets).
# SCENE_MAX_AGE_HOURS=3

# --- Adaptive texting-style mirroring ---
# Passively reads your recent texting habits (message length, emoji use, lowercase, enthusiasm,
# textspeak) and nudges her register to subtly match — without losing her own voice. No model
# call (pure heuristics off the conversation already in memory). On by default.
# STYLE_MIRROR=1
# STYLE_SAMPLE=20      # how many recent messages of yours to read
# STYLE_MIN_MSGS=6     # need at least this many before adapting

# --- Event reminders ---
# When you mention a dated event ("dentist Tuesday at 3", "interview tomorrow"), she resolves
# it to a datetime and schedules two in-character nudges: a "good luck" before and a "how'd it
# go" after. Recurring mentions ("therapy every Tuesday", "check-in Sun/Wed/Sat") instead get a
# single self-rescheduling nudge on each of the named days. All show up in /reminders and can be
# cancelled with /delreminder. On by default.
# A cheap keyword gate means the extra extraction call only fires on messages that look dated.
# EVENT_REMINDERS=1
# EVENT_MODEL=zai-org/glm-4.7-flash
# Ignore events further out than this many days.
# EVENT_HORIZON_DAYS=120
# "Good luck" lands this many minutes before a timed event; "how'd it go" this many hours after.
# EVENT_BEFORE_MIN=45
# EVENT_AFTER_HOURS=2.5
# If you're actively mid-conversation when a nudge is due, it defers rather than interrupting --
# waits this many minutes and re-checks, up to this many times before firing anyway regardless.
# EVENT_NUDGE_BUFFER_MIN=15
# EVENT_NUDGE_MAX_DEFERS=3

# --- Garmin health feed (optional) ---
# When set, she pulls your watch metrics (sleep, resting HR, body battery, steps, last
# workout) a couple times a day and is quietly attuned to how you're doing — gentler on
# a bad-sleep day, hyped after a big workout. She never recites the numbers. Needs the
# library: pip install garminconnect (pure Python; works on Termux). Uses the unofficial
# Garmin Connect login, so it can break when Garmin changes their auth — update the lib then.
# Your password is only used for the first login; after that a token in ~/.garminconnect is reused.
# GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=your-garmin-password
# Times of day (local) to refresh.
# GARMIN_TIMES=07:30,16:00
# Don't inject the snapshot if it's older than this many hours.
# GARMIN_MAX_AGE_HOURS=18
# Stress monitoring: poll recent Garmin stress (0-100, HRV-derived, activity excluded) and have
# her reach out in-character when it stays high. /stress checks it on demand. On with Garmin.
# STRESS_ALERTS=1
# STRESS_THRESHOLD=60          # sustained above this 0-100 score counts as high
# STRESS_SUSTAINED_MIN=45      # must stay high this long to trigger
# STRESS_POLL_MIN=30           # how often to check
# STRESS_ALERT_COOLDOWN_HOURS=4  # don't reach out about stress again within this many hours
# Resting-HR morning check: once a day, flag a resting HR notably above your own rolling baseline
# (an early "run down / coming down with something" signal) and check in gently. /diag shows status.
# RHR_ALERTS=1
# RHR_ELEVATED_DELTA=7    # bpm above your baseline median to flag
# RHR_BASELINE_DAYS=14    # rolling window the baseline is taken from
# RHR_CHECK_TIME=08:00    # local time of the once-daily check
# Body Battery low alert: Garmin's 0-100 energy-reserve gauge drains through the day; when it
# bottoms out you're genuinely depleted, so she gently nudges you to ease off. Polled on the
# same cadence as stress (STRESS_POLL_MIN). /diag shows status.
# BB_ALERTS=1
# BB_LOW_THRESHOLD=20            # body battery at/below this counts as drained
# BB_ALERT_COOLDOWN_HOURS=8      # don't reach out about low energy again within this many hours

# --- Privacy / access control ---

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone (not recommended for personal bots).
# Get your ID by sending /chatid to your bot.
# ALLOWED_USERS=123456789,987654321

# Minimum seconds between messages from the same user (rate limiting)
# RATE_LIMIT_SECONDS=2

# --- Proactive messages ---

# How often the bot sends unprompted check-ins (random between these, in hours)
# HEARTBEAT_MIN_HOURS=2
# HEARTBEAT_MAX_HOURS=6

# Max proactive messages per day (nudge budget). Not an env var — set per chat with the
# /nudges command (e.g. /nudges 6, or /nudges 0 for unlimited). Defaults to 3/day.

# Quiet hours: no proactive messages are sent in this local-time window (there is no separate
# "allowed hour range" setting — quiet hours are the only gate).
# QUIET_START=23:00
# QUIET_END=08:00

# --- Timezone ---

# Timezone for time-aware features (reminders, proactive messages, quiet hours)
# Uses IANA timezone names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# TIMEZONE=America/Los_Angeles

# --- Payments (optional feature) ---

# Enable payment tracking commands (/addpayment, /payments, etc.)
# PAYMENTS_ENABLED=1

# Day of week for weekly payment summary (0=Mon, 6=Sun)
# REMINDER_WEEKDAY=0

# Time for weekly payment reminder (HH:MM)
# REMINDER_TIME=09:00

# --- Scheduled jobs ---

# Time for weekly backup (HH:MM)
# BACKUP_TIME=03:00

# Time for nightly reflection (HH:MM)
# REFLECTION_TIME=02:00
