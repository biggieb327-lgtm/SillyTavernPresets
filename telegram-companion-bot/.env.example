# Copy this file to .env in the same folder and fill in the values.
# Never commit your real .env to version control.

# --- Required ---

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your NanoGPT API key (https://nano-gpt.com)
NANOGPT_API_KEY=your-nanogpt-api-key-here

# --- Optional: API provider ---

# Base URL for the OpenAI-compatible API (default: NanoGPT)
# Change this to use a different provider (e.g. Featherless, Together, local Ollama)
# NANOGPT_BASE=https://nano-gpt.com/api/v1

# --- Optional: model settings ---

# Model to use for chat (default shown)
# NANOGPT_MODEL=zai-org/glm-5:thinking

# Model to use for rolling summaries (can be a cheaper/faster model)
# SUMMARY_MODEL=zai-org/glm-4.7-flash

# Model for emoji reactions (fast/cheap)
# REACTION_MODEL=zai-org/glm-4.7-flash

# Model for mood appraisal (fast/cheap)
# MOOD_MODEL=zai-org/glm-4.7-flash

# Model for image vision tasks. Must support image input.
# VISION_MODEL=zai-org/glm-4.6v

# Fallback model if the primary chat model fails (5xx / timeout)
# FALLBACK_MODEL=gpt-4o-mini

# Fallback model if the vision model fails
# VISION_FALLBACK=gpt-4o

# --- Sampling knobs (optional) ---
# Applied to HER REPLIES only, not to summaries/memory/mood. Only the ones you
# uncomment are sent; anything left unset uses the model's own default. Use these
# to tune a character's voice per-instance (e.g. a hotter temperature for chaos).
# temperature and top_p work on every model; top_k / min_p / repetition_penalty
# are open-model extras NanoGPT passes through for many models (if a model rejects
# one you'll get a 400 — just comment it back out).
#
# Per-character starting points (higher temp = chaos/surprise for manic, absurd,
# scattered voices; lower = control/precision for measured, analytical ones).
# Trust your ear over the numbers — temperature behaves differently per model.
#   Jules   TEMPERATURE=1.1   TOP_P=0.95   chirp chaos, absurd swerves
#   Bonnie  TEMPERATURE=1.05  TOP_P=0.95   manic gremlin, scattered, zero-filter
#   Nora    TEMPERATURE=1.0   TOP_P=0.95   fast, fragmented, riffing but grounded
#   Priya   TEMPERATURE=0.95  TOP_P=0.92   dry wit needs precision, not chaos
#   Emily   TEMPERATURE=0.9   TOP_P=0.9    careful, literal, considered
#   Cass    TEMPERATURE=0.85  TOP_P=0.9    clinical; sharpness comes from control
#
# TEMPERATURE=1.05
# TOP_P=0.95
# TOP_K=
# MIN_P=
# FREQUENCY_PENALTY=0.3
# PRESENCE_PENALTY=0.3
# REPETITION_PENALTY=
# Max tokens per response
# MAX_TOKENS=2048

# Seconds to wait for API response before timing out
# REQUEST_TIMEOUT=300

# --- Optional: character ---

# Character card filename (must be in the bot's base directory)
# CHARACTER_CARD=nora.json

# --- Optional: selfie / image generation ---

# Which backend to use for selfie generation: "gemini" or "nanogpt"
# Defaults to "gemini" if GEMINI_API_KEY is set, otherwise "nanogpt"
# SELFIE_PROVIDER=gemini

# Google Gemini API key (for selfie generation via Gemini)
# GEMINI_API_KEY=your-gemini-key-here

# Gemini image model to use
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Reference photo filename for selfie generation (in the bot's base directory)
# SELFIE_BASE=nora_base.png

# Probability of bot sending a selfie after receiving a photo (0.0–1.0)
# PHOTO_SELFIE_CHANCE=0.20

# --- Optional: voice messages ---

# Whisper model for transcribing voice messages and video audio
# WHISPER_MODEL=whisper-1

# Max video file size in MB to accept (requires ffmpeg: pkg install ffmpeg)
# VIDEO_MAX_SIZE_MB=50

# --- Optional: memory settings ---

# How many messages to keep in the rolling context window
# CONTEXT_LIMIT=40

# Summarize conversation every N turns
# SUMMARY_EVERY=20

# Max milestones to track per chat
# MILESTONES_MAX=30

# --- Semantic memory retrieval (optional, opt-in, pay-as-you-go) ---
# By default, NPC/world memories (memories.txt) are retrieved by keyword + alias
# match. Set EMBED_MODEL to a NanoGPT embedding model to instead rank them by
# meaning, so paraphrases match without exact shared words. Leave unset to keep
# the free keyword retrieval. Embeddings are pay-as-you-go on NanoGPT (cents/year
# at these volumes) — fund a small balance before enabling. If the balance runs
# dry or a call fails, retrieval automatically falls back to keyword matching.
#   BAAI/bge-large-en-v1.5  best value for English (1024d, $0.01/M)
#   BAAI/bge-m3             multilingual (handles other languages, 1024d, $0.01/M)
#   text-embedding-3-small  OpenAI, supports EMBED_DIM reduction (1536d, $0.02/M)
# EMBED_MODEL=BAAI/bge-large-en-v1.5
# Optional output-dimension reduction (text-embedding-3-* only; 0 = model default)
# EMBED_DIM=0
# Cosine-similarity floor (0–1) for a memory to count as relevant. Raise to be
# stricter (fewer, tighter matches), lower to surface more.
# EMBED_MIN_SIM=0.35

# --- Episodic recall (optional; needs EMBED_MODEL above + numpy) ---
# Archives conversation as it scrolls out of the live window and pulls the most
# relevant *past exchange* back into context per turn — verbatim recall beyond the
# rolling summary ("remember that night you told me about your dad's piano"). On by
# default when EMBED_MODEL is set; reuses the per-turn query vector, so no extra
# per-turn embedding cost. Requires numpy (pip install numpy).
# EPISODIC_RECALL=1
# Hard cap on archived chunks per bot (RAM/disk bound; ~4 KB each at 1024 dims).
# EPISODE_MAX=4000
# Messages per archived chunk (with 1 message of overlap).
# EPISODE_CHUNK_MSGS=6
# Cosine floor to surface a past moment (higher than EMBED_MIN_SIM on purpose —
# only resurface something genuinely resonant).
# EPISODE_MIN_SIM=0.40
# How many past moments to surface per turn.
# EPISODE_TOPK=1
# Don't recall anything newer than this many hours (keeps the live window from
# being echoed back).
# EPISODE_MIN_AGE_HOURS=24

# --- Offline life (autonomous events in her world) ---
# A couple times a day she "lives" between conversations: a short concrete event is
# generated from her schedule/people/projects (a teammate did X, a shift went sideways)
# and stored, so she has real news to bring up and proactive check-ins aren't generic.
# No embeddings needed; uses a cheap chat model. /news shows them, /newsnow forces one.
# LIFE_SIM_ENABLED=1
# Times of day (local) to generate an event.
# LIFE_EVENT_TIMES=13:00,20:30
# How many recent events to keep.
# LIFE_EVENTS_MAX=8
# Model for generating events (cheap/fast is fine).
# LIFE_MODEL=zai-org/glm-4.7-flash

# --- Privacy / access control ---

# Comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone (not recommended for personal bots).
# Get your ID by sending /chatid to your bot.
# ALLOWED_USERS=123456789,987654321

# Minimum seconds between messages from the same user (rate limiting)
# RATE_LIMIT_SECONDS=2

# --- Proactive messages ---

# How often the bot sends unprompted check-ins (random between these, in hours)
# HEARTBEAT_MIN=2
# HEARTBEAT_MAX=6

# Max proactive messages per day (nudge budget)
# NUDGE_MAX=3

# Hour range (local time) during which proactive messages can be sent
# PROACTIVE_HOUR_START=9
# PROACTIVE_HOUR_END=21

# --- Timezone ---

# Timezone for time-aware features (reminders, proactive messages)
# Uses IANA timezone names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BOT_TIMEZONE=America/New_York

# --- Payments (optional feature) ---

# Enable payment tracking commands (/addpayment, /payments, etc.)
# PAYMENTS_ENABLED=1

# Day of week for weekly payment summary (0=Mon, 6=Sun)
# REMINDER_WEEKDAY=0

# Time for weekly payment reminder (HH:MM)
# REMINDER_TIME=09:00

# --- Scheduled jobs ---

# Time for weekly backup (HH:MM)
# BACKUP_TIME=03:00

# Time for nightly reflection (HH:MM)
# REFLECTION_TIME=02:00
