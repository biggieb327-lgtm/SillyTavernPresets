# Copy this file to .env in the same folder and fill in the values.
# Never commit your real .env to version control.

# --- Required ---

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your NanoGPT API key (https://nano-gpt.com). Confirmed on-device 2026-07-17: this
# was the SAME key value across all six phone-era instances (one NanoGPT account) —
# unlike TOMTOM_API_KEY below, which is per-bot. Not independently reconfirmed for
# marcus (added 2026-07-29) — verify his .env matches before assuming it does. If an
# instance's .env is ever missing this line, copy it from a sibling instance's .env
# rather than treating it as unique.
NANOGPT_API_KEY=your-nanogpt-api-key-here

# --- Optional: API provider ---

# Base URL for the OpenAI-compatible API (default: NanoGPT)
# Change this to use a different provider (e.g. Featherless, Together, local Ollama)
# NANOGPT_BASE=https://nano-gpt.com/api/v1

# --- Optional: model settings ---

# Model to use for chat (default shown)
# NANOGPT_MODEL=zai-org/glm-5:thinking

# Model for background work: rolling summaries, the weekly memory audit, day events,
# world text, and the JSON extraction passes. Can be cheaper/faster than the chat model.
#
# As of v2026-07-29.3 this slot is background work ONLY — safe to point at a small,
# cheap model. Until then it also wrote the selfie and meme captions, so an instance
# that chose a fast summariser was silently having that model write the character's
# dialogue (jules ran glm-4.7-flash and sent a selfie captioned with invented
# instruction blocks, three people who do not exist in her card, and word salad).
# Captions now have their own slot: see CAPTION_MODEL below.
# SUMMARY_MODEL=zai-org/glm-4.7

# Model for USER-FACING captions in the character's voice — the selfie caption and the
# meme caption. Defaults to NANOGPT_MODEL (the chat model), which is what you want: her
# voice should come from her own model. Set this only to deliberately point captions
# somewhere else; it is the per-instance override, no redeploy needed.
# CAPTION_MODEL=zai-org/glm-5.1:thinking

# Model for emoji reactions (fast/cheap)
# REACTION_MODEL=zai-org/glm-4.7-flash

# Model for mood appraisal (fast/cheap)
# MOOD_MODEL=zai-org/glm-4.7-flash

# Model for image vision tasks. Must support image input.
# VISION_MODEL=zai-org/glm-4.6v

# Fallback model if the primary chat model fails (5xx / timeout)
# Magnum v4 72B is the recommended fallback for roleplay — strong character voice,
# good at casual texting register. Euryale v2.3 is a solid alternative.
# FALLBACK_MODEL=anthracite-org/magnum-v4-72b
# FALLBACK_MODEL=Sao10K/L3.3-70B-Euryale-v2.3

# Fallback model if the vision model fails
# VISION_FALLBACK=gpt-4o

# Max tokens per response (default 4096). This is a CAP, not a target — replies stay
# short. Thinking models (…:thinking) spend tokens reasoning before the answer, so a low
# cap can leave no room for the reply itself (empty completions). Lower it only if you
# use a non-thinking model and want to bound cost.
# MAX_TOKENS=4096

# Temperature (0.0 = deterministic, 1.0 = default, higher = more random)
# If unset, uses the model's default
# TEMPERATURE=1.0

# Hard cap in seconds per API request (default 120)
# REQUEST_TIMEOUT=120

# Max seconds of silence between streaming chunks before aborting (default 90)
# Lower = faster stall detection; raise if your model has long thinking pauses
# or your connection is slow/congested
# STREAM_TIMEOUT=90

# --- Optional: performance tuning ---

# Responses are now streamed — if the model goes silent for STREAM_TIMEOUT seconds
# mid-response, the request aborts and retries (or falls back). This catches stalls
# much faster than the old 300s read timeout.

# The default chat model (glm-5:thinking) is a reasoning model — accurate but slow.
# For faster responses, switch to a non-reasoning model:
# NANOGPT_MODEL=zai-org/glm-5
# NANOGPT_MODEL=deepseek/deepseek-v4-flash

# Fallback model bounds worst-case latency. Without one, all retries hit the same
# slow model. Set to a fast model so failures recover quickly:
# FALLBACK_MODEL=anthracite-org/magnum-v4-72b

# Inner voice adds a private thought before the main reply (extra LLM round-trip).
# Disabled by default for speed. Enable for richer subtext (adds 1-5s latency):
# INNER_VOICE_ENABLED=true

# Typing delay simulates natural typing speed (0.5-3.5s after LLM returns).
# Disable for instant delivery:
# TYPING_DELAY=0

# Schedule-driven unavailability (default ON): when the current time falls inside an
# explicit HH:MM-HH:MM range in today's schedule.txt section, she replies in a shorter
# register, types slower (delay x SCHED_BUSY_DELAY_MULT, private chats only), and may
# say she has to get back to what she's doing. Lines without an explicit time range
# never trigger it. Kill switch:
# SCHED_BUSY=0
# SCHED_BUSY_DELAY_MULT=3.0

# Social battery (default ON): fatigue 0-100 tracked arithmetically per chat — intense
# exchanges (|valence| >= 2) drain it, calm-positive ones recharge it, and it decays
# FATIGUE_DECAY_PER_HOUR while idle. Above FATIGUE_THRESHOLD she reads as socially
# drained, and minimal replies ('k', an emoji) become legitimate complete responses
# (also when busy per SCHED_BUSY, or in a low mood). FATIGUE_STATE=0 kills both the
# battery and the minimal-reply license. No LLM calls anywhere in it.
# FATIGUE_STATE=0
# FATIGUE_THRESHOLD=70
# FATIGUE_DECAY_PER_HOUR=10

# Day-mood residue (default ON): the midnight day generator also emits how she feels
# heading into the day; that seeds her mood so her generated life colors how she opens
# conversations. Same single LLM call as before — one extra output line. Kill switch:
# DAY_MOOD_RESIDUE=0

# Link reading fetches URL content before replying. Disable or shorten timeout:
# LINK_READING=false
# LINK_FETCH_TIMEOUT=8

# --- Optional: character ---

# Character card filename (must be in the bot's base directory)
# CHARACTER_CARD=nora.json

# --- Optional: selfie / image generation ---

# Which backend to use for selfie generation: "gemini" or "nanogpt"
# Defaults to "gemini" if GEMINI_API_KEY is set, otherwise "nanogpt"
# SELFIE_PROVIDER=gemini

# Google Gemini API key (for selfie generation via Gemini)
# GEMINI_API_KEY=your-gemini-key-here

# Gemini image model to use
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Reference photo filename for selfie generation (in the bot's base directory)
# SELFIE_BASE=nora_base.png

# Probability of bot sending a selfie after receiving a photo (0.0–1.0)
# PHOTO_SELFIE_CHANCE=0.20

# --- Optional: memes ---
# Template + text-overlay memes (not AI-generated — reliable, legible captions).
# Templates live in meme_templates/ and the font in fonts/, shared alongside bot.py
# (not per-instance). See /meme in Telegram, or the [meme: top | bottom] tag she can
# use in-character.

# Starting font size in points before auto-shrink-to-fit kicks in
# MEME_FONT_SIZE=80

# How many recently-used templates to avoid repeating per chat
# MEME_DEDUP_SIZE=5

# --- Optional: voice messages ---

# TTS provider is chosen automatically: if INWORLD_API_KEY is set, voice
# replies use Inworld (api.inworld.ai) with TTS_VOICE as the Inworld voice ID
# (including cloned voices). Otherwise NanoGPT's /audio/speech is used with
# TTS_MODEL/TTS_VOICE (OpenAI-style: tts-1 + alloy/echo/fable/onyx/nova/shimmer).

# Inworld runtime API key — the base64 key from the Inworld portal (Basic auth)
# INWORLD_API_KEY=your-inworld-base64-key-here

# Inworld TTS model (default inworld-tts-2)
# INWORLD_TTS_MODEL=inworld-tts-2

# Voice: Inworld voice ID when using Inworld, OpenAI voice name otherwise
# TTS_VOICE=Zadieova

# Probability of replying with voice when the user sent a voice note (0.0–1.0).
# Only applies when /voice is on. Independent of TTS_CHANCE, which governs text→voice.
# VOICE_REPLY_TO_VOICE=0.9

# Whisper model for transcribing voice messages and video audio
# WHISPER_MODEL=whisper-1

# Max video file size in MB to accept (requires ffmpeg: pkg install ffmpeg)
# VIDEO_MAX_SIZE_MB=50

# --- Optional: memory settings ---

# Embedding model for semantic memory recall (uses NanoGPT's /v1/embeddings).
# Memories are embedded on write and cached in embeddings.json; queries are embedded
# on recall and matched by cosine similarity, merged with keyword results.
# Falls back silently to keyword-only if the API is unavailable.
# EMBEDDING_MODEL=text-embedding-3-small

# Verbatim conversation window. CORRECTED 2026-07-25: this file previously documented
# CONTEXT_LIMIT and SUMMARY_EVERY — bot.py reads NEITHER, so setting them did nothing.
# The window is bounded three ways, and only the time bound is configurable:
#   MAX_HISTORY   = 20  (hardcoded) verbatim message cap, marathon-session safety
#   KEEP_RECENT   = 10  (hardcoded) never distilled below this many
#   SHORT_TERM_HOURS    messages older than this get summarised out — settable:
# SHORT_TERM_HOURS=48
#
# Summarisation is triggered by that overflow, not by a turn count, so there is no
# "every N turns" knob. See CONTEXT_TOKEN_BUDGET (above) for the token-based ceiling.

# Weekly memory audit loop: one cheap-model (SUMMARY_MODEL) pass over memories.txt
# proposing contradiction/superseded/stale merges and deletions into the /reviewmem
# queue. It never deletes anything itself — every proposal needs your ok, and a
# rejected proposal is never re-proposed. Default ON since v2026-07-27.1; set 0 to
# disable. Budget the triage: up to MEMORY_AUDIT_MAX_PROPOSALS per instance per week.
# MEMORY_AUDIT=0
# MEMORY_AUDIT_WEEKDAY=6            # 0=Mon .. 6=Sun (runs with the nightly reflection job)
# MEMORY_AUDIT_MAX_PROPOSALS=3      # per weekly run

# Recency decay for memory recall ranking: exponential half-life in days. Older
# memories rank lower (floored at 0.1x, so they fade, never vanish). Entries
# without a recorded timestamp (pre-2026-07) are never down-weighted.
# Default 90 since v2026-07-27.1; set 0 to disable ranking decay entirely.
# MEMORY_DECAY_HALFLIFE_DAYS=0

# Repeat-injection suppression (v2026-07-18.1): memory recall re-ranks all memories
# against the recent conversation every turn, so a stable theme makes the same lines
# win the budget turn after turn and the character re-tells one memory (reworded)
# endlessly. This down-weights (never excludes) memories injected on recent turns so
# near-ties rotate; it also adds a "don't re-raise a memory you just referenced" line
# to the prompt. Default ON (6); set 0 to disable. Kill switch, not opt-in.
# MEMORY_REPEAT_SUPPRESS_TURNS=6
# MEMORY_REPEAT_PENALTY=0.15         # score x this the turn after injection, fading to 1.0

# --- Layered presets (v2026-07-25.5) ---
# An ordered, comma-separated list of preset layer files, each read from THIS instance's
# directory and injected as its own system block. Unset = use PRESET_FILE (below), which
# defaults to the single shared preset.txt — i.e. today's behaviour, byte-identical.
#
# Why: the shared preset is ~8,500 tokens on every message for every bot, and most of it
# is scene/NPC/roleplay machinery. A writing-collaborator instance like cass can never use
# it, so it was paying ~6,000 tokens to dilute the ~700 tokens of live per-turn context it
# actually needs. Measured with a core/rp/feature split: cass 11,031 -> 4,758 tokens
# (-57%); jules unchanged, because she genuinely uses every layer.
#
# Every layer file in the repo is synced to every instance (sync-cards.sh copies
# preset-*.txt; vps-sync.sh pulls exactly the layers named here). PRESET_FILES decides
# which ones a given bot loads. A named layer that is missing on disk logs a config
# warning and shows in /audit — it does NOT fail silently, because quietly dropping voice
# rules looks like a model regression.
#
# The layers that exist in the repo (v2026-07-25.6):
#   preset-core.txt       4,166 tok — voice, anti-slop, agency, epistemic horizon, repair,
#                                    self-check. EVERY character wants this.
#   preset-rp.txt         1,680 tok — narration, NPC management, scene continuity/rhythm.
#                                    Skip for non-roleplay instances (e.g. a writing editor).
#   preset-explicit.txt   1,930 tok — Dead Dove guide + explicit content module.
#   preset-stepped.txt      403 tok — pairs with STEP_INTENT (default on).
#   preset-closeness.txt    323 tok — pairs with CLOSENESS_ENABLED (default OFF, so most
#                                    instances should NOT load this).
#
# Per-character layers (2026-07-26). Each bot also has a small preset-<name>.txt (~250-290
# raw tok) holding the rules that are about FORMAT and voice rather than identity — the
# things the shared core cannot get right for everyone at once. The cards already carry
# personality; these layers exist because the cards disagree with the shared preset about
# how a reply should be shaped, and something has to say which one wins:
#   preset-bonnie.txt  her card says 3-6 paragraphs, core says "one to three short" and
#                      "prefer shorter" — this states that the card wins. She is the one
#                      character on the fleet who runs long by design.
#   preset-priya.txt   lowercase, no markdown, no asterisks, "two words is a complete
#                      reply" — core's paragraph default is a ceiling for her, not a target.
#   preset-emily.txt   she is written in THIRD PERSON with italicised action beats, the
#                      only one on the fleet; overrides the first-person texting framing.
#   preset-cass.txt    texts, never narrates, never in a scene; names the fix in the same
#                      message as the problem; never restates a landed point.
#   preset-nora.txt    running text thread, not a scene; curious by talking rather than
#                      interrogating; the grief shows as behaviour, never as narration.
#   preset-jules.txt   chirp density never throttled; attraction surfaces as escalated
#                      cruelty; softening her to release a moment is a character bug.
#   preset-marcus.txt  third person, prose and action beats; and the one that is NOT about
#                      format — preset-explicit.txt's standing-consent block forbids
#                      checking in or "seeking permission", while his whole character is
#                      asking first and declining what crosses his code. The layer scopes
#                      that rule to the narrator's relationship with {{user}}, leaving his
#                      in-fiction asking intact. ~430 raw tok, above the band on purpose.
#
# Recommended stacks (measured; "cal" is at a 0.92 calibration ratio — see /audit):
#   bot     PRESET_FILES                                                    raw    cal
#   cass    core,stepped,cass                                              4827   4441
#   priya   core,stepped,priya                                             4830   4444
#   nora    core,rp,explicit,stepped,nora                                  8505   7825
#   bonnie  core,rp,explicit,stepped,bonnie                                8521   7839
#   emily   core,rp,explicit,stepped,emily                                 8501   7821
#   jules   core,rp,explicit,stepped,jules                                 8538   7855
#   marcus  core,rp,explicit,stepped,marcus                                8740   8041   (not yet live)
#
# The marcus row was measured 2026-07-28; the six above it were measured when they were
# added and are now ~60 raw low, because preset-core.txt and preset-explicit.txt have both
# grown since. Compare a row against the fleet, not against the others in this table.
#
# Against today's monolithic preset.txt (8503 raw): cass and priya shed ~43%, and the four
# scene characters pay within ±35 tokens for a stack that actually fits them. The saving is
# concentrated exactly where a character cannot use the scene machinery, which is the
# honest shape of this change — it is a fit exercise, not a token-cutting one.
#
#   cass (writing collaborator): PRESET_FILES=preset-core.txt,preset-stepped.txt,preset-cass.txt
#   priya (texter, no scenes):   PRESET_FILES=preset-core.txt,preset-stepped.txt,preset-priya.txt
#   scene instances:             PRESET_FILES=preset-core.txt,preset-rp.txt,preset-explicit.txt,preset-stepped.txt,preset-<name>.txt
#
# Order matters only for reading order in the prompt; layers are independent.
# PRESET_FILES=preset-core.txt,preset-stepped.txt
#
# If PRESET_FILES names layers and NONE are on disk, the bot falls back to the shared
# preset.txt (then the built-in default) and logs why — it will not silently run on a stub.
# Still: deploy the layer files before/with the .env edit. vps-sync.sh reads PRESET_FILES
# to know which layers to pull, so edit .env first, THEN run vps-sync.sh.
#
# Legacy single-file form, still honoured. Ignored when PRESET_FILES is set.
# PRESET_FILE=preset.txt

# --- /preset: switch layers from Telegram (v2026-07-26.1) ---
# Kill switch for the /preset command, which swaps THIS instance's layer stack live —
# effective on the next message, no restart. Admin-only (same gate as /restart), because
# it rewrites the voiceprint for every chat the instance serves and can move the
# per-message bill by thousands of tokens. The choice persists in state.json and is
# re-applied on startup.
#
# Default ON. Set to 0 to unregister the command AND make startup ignore a saved
# override — that pairing is the point: a stack that ruins a character's voice is undone
# with one .env line plus a restart, without hand-editing state.json.
#
# What /preset can choose from is what is ON DISK in the instance directory —
# vps-sync.sh deliberately pulls only the layers PRESET_FILES names, so an instance can
# only switch among those until its .env names more (then re-run vps-sync.sh to fetch
# the newly named layer file). /preset with no arguments lists exactly what that
# instance has.
# PRESET_COMMAND=1

# --- Token counts: measured, not guessed (v2026-07-26.2) ---
# Every token figure the bot reported used to be len(text)//4 shown as "~Nt" — a rule of
# thumb for English prose, applied to bracketed markdown presets, with one constant
# divisor for seven bots running different models with different tokenizers.
#
# The API already returns the truth: `usage.prompt_tokens`, counted by the real tokenizer
# for the real model. /usage and /audit now spend that number directly, and each measured
# call also gives an (estimated, actual) pair for the same text, which calibrates the
# character heuristic for the things that are never sent on their own — "what would this
# preset layer cost if I added it". /preset and /audit label which they are showing.
#
# Default ON. Set to 0 to report the raw heuristic instead (the unit every historical
# number in CHANGELOG.md and ROADMAP.md was measured in). The calibration ratio is stored
# per instance in state.json and is model-specific — expect it to move after /setmodel.
#
# NOT affected, deliberately: MEMORY_TOKEN_BUDGET still counts in raw units, because it is
# a tuned recall knob rather than a cost ceiling, and recalibrating it would change how
# much six live characters remember. See ROADMAP 4.4.
# TOKEN_CALIBRATION=1

# Assembled-prompt size tracking (v2026-07-25.3). Records the size of each prompt as it
# is built, plus the running max and a coarse histogram, surfaced on the /audit "Prompt:"
# line together with the three largest system blocks at the maximum. Nothing measured a
# SINGLE prompt before this — the existing token counter is a daily running sum, which
# cannot answer "how big does this get on a bad day". In-memory only; a restart resets it.
# Default ON; set 0 to disable the bookkeeping.
# PROMPT_STATS=1

# Hard ceiling on the assembled prompt, in estimated tokens. 0 = off (default).
# Since v2026-07-25.4 the trimmer gives up context in a sane order: optional blocks
# (lore, recalled memories, inside jokes, local-places sample, open threads, day context,
# recent-questions) go first, largest first; then history oldest-first; then, only as a
# last resort, the newest KEEP_RECENT turns. Voice-critical blocks — the card, preset.txt,
# capabilities, post-history instructions — and the final user message are never dropped.
#
# Set it from evidence, not a guess: check /audit's "Prompt:" line for this instance's
# real max, then leave headroom. A budget BELOW the protected-block total cannot be met
# no matter what is dropped; that case now logs a WARNING and counts a prompt_budget
# error rather than silently shipping over. If you hit it, the fix is a smaller preset or
# card (see the "Prompt:" top-blocks breakdown), not a lower budget.
# CONTEXT_TOKEN_BUDGET=0

# Topic-initiative balance (v2026-07-25.1): of the ~15 system blocks in the prompt, only
# the two RECALL blocks (user_notes, open threads) told the character to raise their
# contents — her live context (her day, her schedule, the weather) was passive, and the
# day.txt block was explicitly told NOT to be foregrounded. Result: remembering was the
# only sanctioned way for her to open a topic. This adds a "# Bringing things up" block
# stating that what she's doing now is as valid as anything she recalls, and rewrites the
# notes/threads/day tails to match. NOT a memory-quality change — nothing is removed from
# the prompt. Default ON; set 0 to restore the previous wording exactly.
# PROMPT_BALANCE=1

# Prefix "(unsure)" on recalled memories whose recorded confidence is below
# MEMORY_AUTOCONF, so the character hedges instead of asserting them as fact.
# For hedged memories that recorded a source snippet, the snippet is also shown
# to the model so it can self-check. Default ON since v2026-07-27.1; set 0 to disable.
# MEMORY_HEDGE=0

# Live semantic recall (v2026-07-12.2): embed each user message once per reply so
# semantic memory recall AND semantic lorebook matching actually fire during chat
# (previously the vectors were written on every memory add but never read in a live
# reply). The embed runs off the event loop, is cached, and falls back to
# keyword-only on timeout. Default ON — set 0 to disable without a redeploy.
# MEMORY_SEMANTIC_LIVE=1
# MEMORY_QUERY_EMBED_TIMEOUT=3.0     # seconds before falling back to keyword-only
# MEMORY_DEDUP_SIM=0.92              # cosine >= this on write = near-duplicate, skipped
# MEMORY_LORE_SEMANTIC_TOPK=3        # semantic lore hits added per turn (floor 0.3)

# Max milestones to track per chat
# MILESTONES_MAX=30

# --- Privacy / access control ---

# Comma-separated list of Telegram user IDs allowed to use the bot.
# When set, ALL private-chat interaction from anyone else is silently ignored —
# commands, messages, media, buttons (enforced centrally, v2026-07-13.1). The
# owner (OWNER_CHAT_ID or the claimed owner_chat.txt) always passes even if not
# listed. Leave empty to allow anyone (not recommended for personal bots).
# Get your ID by sending /chatid to your bot.
# ALLOWED_USERS=123456789,987654321

# Minimum seconds between messages from the same user (rate limiting)
# RATE_LIMIT_SECONDS=2

# --- Proactive messages ---

# How often the bot sends unprompted check-ins (random between these, in hours).
# CORRECTED 2026-07-25: the names here were HEARTBEAT_MIN / HEARTBEAT_MAX, which bot.py
# does not read — those are its internal seconds-valued Python variables. The env vars
# take HOURS and end in _HOURS. Setting the old names was a silent no-op.
# HEARTBEAT_MIN_HOURS=2
# HEARTBEAT_MAX_HOURS=6

# Max proactive messages per day (nudge budget).
# CORRECTED 2026-07-25: NUDGE_MAX was documented here but does not exist in bot.py. The
# budget is per-chat RUNTIME state (default 3/day, 0 = unlimited), set from Telegram:
#     /nudges 3
# There is no env var for it, and there never was.

# Quiet hours — the real control over when proactive messages may be sent.
# CORRECTED 2026-07-25: PROACTIVE_HOUR_START / PROACTIVE_HOUR_END were documented here
# and are read nowhere in bot.py. Quiet hours are a suppression window (HH:MM, local,
# may wrap midnight), not an allowed-hours range, so the sense is inverted from what the
# old names implied.
# QUIET_START=23:00
# QUIET_END=08:00

# --- Timezone ---

# Timezone for time-aware features (reminders, proactive messages)
# Uses IANA timezone names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BOT_TIMEZONE=America/New_York

# --- Payments (optional feature) ---

# Enable payment tracking commands (/addpayment, /payments, etc.)
# PAYMENTS_ENABLED=1

# Day of week for weekly payment summary (0=Mon, 6=Sun)
# REMINDER_WEEKDAY=0

# Time for weekly payment reminder (HH:MM)
# REMINDER_TIME=09:00

# --- Admin HTTP API (VPS deployments only, opt-in) ---

# Mirrors /audit /errors /backup /update /restart over HTTP for non-Telegram clients
# (e.g. a control-panel app). Fully inert if left unset — Termux instances don't need
# this. Meant to be reached only over a private Tailscale network, never the public
# internet; see telegram-companion-bot/deploy/install-vps.sh.
# ADMIN_API_ENABLED=1

# Required if ADMIN_API_ENABLED is set — every route except GET /admin/health needs
# this as `Authorization: Bearer <token>`. install-vps.sh generates one per instance.
# ADMIN_API_TOKEN=

# Port to listen on (default 8765)
# ADMIN_API_PORT=8765

# Address to bind. Defaults to 127.0.0.1 (loopback-only, unreachable) so a
# misconfigured instance fails closed. Set to the host's Tailscale IP
# (`tailscale ip -4`) to actually expose it over the tailnet — never 0.0.0.0.
# ADMIN_API_BIND=127.0.0.1

# --- Fleet console (/fleet) ---

# Set on ONE designated instance to make its /fleet command probe every peer's
# admin API and reply with a fleet summary (up/down, version, uptime, and — when
# the fleet shares one ADMIN_API_TOKEN — last-hour error count). Format is
# comma-separated name=port (same host) or name=host:port (over the tailnet),
# so it keeps working mid-VPS-migration while instances live on two hosts.
# Each listed peer needs ADMIN_API_ENABLED=1; port = that instance's ADMIN_API_PORT.
# Unset = /fleet explains how to configure itself and does nothing else.
# FLEET_PEERS=nora=8080,bonnie=8081,cass=8082,emily=8083,priya=8084,jules=100.x.y.z:8085

# Kill switch for the /fleet command (unset = on; 0 disables without a redeploy).
# FLEET_CMD=1

# Per-peer probe timeout in seconds (default 4).
# FLEET_TIMEOUT=4

# --- Monitoring (dead man's switch) ---

# Per-instance ping URL (e.g. from healthchecks.io, free tier). The bot GETs it
# every 30 minutes; the service alerts you when pings STOP — catching everything
# a dead bot can't self-report, including the whole host being down.
# Create one check per bot; set the period to 30 min with ~15 min grace.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# Monthly spend budget (same unit as NanoGPT's usage API). When set, the bot
# DMs the owner at 80% and 100% of this amount (checked every 30 min, 24h cooldown).
# USAGE_BUDGET_MONTHLY=50

# --- Shared world context ---

# When set to 1, this instance generates world.txt at midnight — a shared backdrop
# (weather, ambient local happenings) that all instances read during day generation.
# Only ONE instance should have this set (typically the home instance / nora).
# WORLD_GENERATOR=1

# Path to the shared world.txt (default: alongside bot.py, i.e.
# /opt/telegram-bots/world.txt on the VPS). All instances read from this path; only the
# generator writes to it.
# WORLD_FILE=/opt/telegram-bots/world.txt

# --- Group chat (experimental — read GROUP_CHAT_DESIGN.md before enabling) ---

# Master switch. Even when off, group chats are ignored fleet-wide (fail closed):
# no commands except /chatid, no replies, no state. Enable on the pilot pair only.
# Requires BotFather privacy mode DISABLED for this bot (then re-add it to the group).
# GROUP_MODE=1

# REQUIRED with GROUP_MODE: comma-separated group chat ids this bot may join in on.
# A group not listed here is ignored entirely. Get the id with /chatid in the group.
# GROUP_ALLOWED_CHATS=-1001234567890

# Names of the other character(s) in the group, for her group-context prompt
# GROUP_PEERS=Jules

# Optional one-line relationship note per peer ("Name: line; Name2: line")
# GROUP_PEER_NOTES=Jules: a friend you know through Brian; you find her funny

# Chance of replying to a peer bot's unaddressed message (0.0-1.0, default 0.35)
# GROUP_BOT_REPLY_PROB=0.35

# Max consecutive bot messages since the last human one (default 2). The loop cap.
# GROUP_BOT_CHAIN_MAX=2

# Ledger poll cadence in seconds (default 5) — how fast she hears the other bot
# GROUP_POLL_SECONDS=5

# Min seconds between her own group messages (default 20)
# GROUP_MIN_GAP_SECONDS=20

# Max bot-to-bot replies per day (default 30). Human-addressed replies are unaffected.
# GROUP_DAILY_BOT_BUDGET=30

# Shared dir for the group ledger + claim files (default: alongside bot.py).
# All participating instances must point at the SAME directory.
# GROUP_LEDGER_DIR=/data/data/com.termux/files/home/telegram-bot

# --- Scheduled jobs ---

# Time for weekly backup (HH:MM)
# BACKUP_TIME=03:00

# Time for nightly reflection (HH:MM)
# REFLECTION_TIME=02:00

# Time of day to follow up on dated user notes, e.g. "interview Tuesday" ->
# she asks how it went that evening (HH:MM; respects quiet hours + nudge budget)
# NOTE_FOLLOWUP_TIME=18:00

# Recurring events mentioned in conversation ("derby every Thursday") get an
# (every …) marker and re-fire naturally at each occurrence instead of once.
# Kill switch: set to 0 to capture them as one-off notes like before (default 1)
# NOTE_RECURRING=1

# Reject user notes not backed by a verbatim quote from the user's own messages —
# blocks the character's roleplay/scene lines from becoming "facts" about the user.
# Set to 0 to store notes ungrounded like before (default 1)
# NOTE_GROUNDED=1

# Minimum self-reported confidence (1-10) for auto-accepting a note.
# The analysis model rates its own confidence; notes below this threshold are
# rejected — null over plausible guess. 0 = accept all (old behavior). Default 3
# NOTE_AUTOCONF=3

# Days a retired "(asked …)" note stays in the file before the daily follow-up
# job prunes it. 0 = keep forever (old behavior). Default 7
# NOTE_ASKED_TTL_DAYS=7

# Word-overlap threshold (0-1) for treating a new note as a duplicate of an
# existing one ("2pm call with Yuen" vs "call with Yuen in eight minutes").
# 0 = prefix-only dedup (old behavior). Default 0.8
# NOTE_DEDUP_SIM=0.8

# --- WSDOT Traffic (Western Washington) ---

# WSDOT Traveler Information API access code (free at wsdot.wa.gov/traffic/api)
# When set, enables /traffic, /incidents, live location alerts, and 10-min polling
# WSDOT_API_KEY=your-access-code-here

# Radius in miles for location-based incident alerts (default 10)
# TRAFFIC_RADIUS_MILES=10

# How often to poll for new nearby incidents when live location is active (minutes)
# TRAFFIC_POLL_MINUTES=10

# --- Garmin health feed (v2026-07-25.2) ---
# She quietly knows how you're doing physically: sleep, resting HR, steps, Body Battery,
# stress, last workout. Injected as prompt context (never recited as numbers) plus three
# optional proactive check-ins. Zero extra LLM calls — the check-ins reuse the existing
# proactive path, and every Garmin call runs off the event loop.
#
# REQUIRES the optional library, which is NOT in requirements.txt (not every instance
# has a watch, and the venv is shared across all seven):
#   /opt/telegram-bots/venv/bin/pip install garminconnect
# With credentials set but the library missing, the feed is inert and says so in /audit.
#
# Your Garmin Connect login. Unset = feature completely inactive.
# GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=your-garmin-password
#
# Kill switch (default ON): set 0 to disable the feed without deleting credentials.
# GARMIN_FEED=1
#
# GARMIN_TIMES=07:30,16:00        # local times to pull a fresh snapshot (also once at startup)
# GARMIN_MAX_AGE_HOURS=18         # older than this and the snapshot stops being injected
# GARMIN_LOGIN_COOLDOWN=1800      # secs to back off after a failed (rate-limited) login
# GARMINTOKENS=~/.garminconnect   # token store, so restarts resume instead of re-logging in
#
# Proactive check-ins. Each is quiet-hours + away + nudge-budget gated and has its own
# persisted cooldown, so a restart can't re-fire one. Set 0 to disable individually.
# STRESS_ALERTS=1
# STRESS_THRESHOLD=60             # 0-100; sustained above this = high
# STRESS_SUSTAINED_MIN=45         # must stay high this long to trigger
# STRESS_POLL_MIN=30              # poll cadence for stress AND body battery
# STRESS_ALERT_COOLDOWN_HOURS=4
# BB_ALERTS=1
# BB_LOW_THRESHOLD=20             # body battery at/below this = drained
# BB_ALERT_COOLDOWN_HOURS=8
# RHR_ALERTS=1
# RHR_ELEVATED_DELTA=7            # bpm above your own baseline to flag
# RHR_BASELINE_DAYS=14            # rolling window for the baseline median
# RHR_BASELINE_MIN_DAYS=3         # no alerts until this many prior days exist
# RHR_CHECK_TIME=08:00

# --- TomTom Maps (routing + place/POI search; Nora, Emily, Priya) ---

# Free API key from https://developer.tomtom.com (enable Search + Routing APIs).
# When set, enables /route, /nearby, /place. Unset = those commands are disabled
# (fail-closed). The MCP TomTom connector in Claude sessions does NOT provide this;
# each bot needs its own key here.
# TOMTOM_API_KEY=your-tomtom-key-here

# Default travel mode for /route: car | bicycle | pedestrian (also truck/taxi/bus/
# van/motorcycle). Recommended per character: Nora=bicycle, Emily=car, Priya=pedestrian.
# Invalid values log a [tomtom] warning and fall back to car.
# TOMTOM_TRAVEL_MODE=car

# In-character restaurant recs (needs TOMTOM_API_KEY). When on: if the user asks
# about food and has shared their location, real nearby restaurants are handed to
# the model so it recommends them in character (no extra AI call). Off = today's
# behavior. Enable per character you want it on (e.g. Nora/Emily/Priya).
# FOOD_SUGGESTIONS=1

# Generalized map intent (needs TOMTOM_API_KEY; independent of FOOD_SUGGESTIONS).
# When on: an explicit map-shaped ask — "how do I get to X", "how far is X",
# "is there a <thing> nearby", "closest <thing>" — pre-fetches a real TomTom
# route or place list into the same single reply, so times/distances/places come
# from the map, not imagination (no extra AI call). Route origin is the user's
# shared location (fresh within 4h or live); without one she asks for a pin.
# Off/unset = today's behavior exactly. Enable per TomTom-keyed character.
# MAP_INTENT=1

# --- R6 Evolution experiments (default off, pilot one instance at a time) ---

# 👍/👎 reactions on bot messages → mood nudge + feedback log + recalibration note
# FEEDBACK_REACTIONS=1

# Derived relationship-depth score shown in /status + injected as system context
# CLOSENESS_ENABLED=1

# Multi-thread next_goals (str → list of 3); updated via post_reply_analysis
# THREADS_ENABLED=1

# Auto-detect inside-joke candidates and queue them for /reviewmem curation
# JOKE_CANDIDATES=1

# Stepped-thinking intent seed (SillyTavern st-stepped-thinking, folded in): the
# combined post-reply analysis pass also emits a one-line "frame of mind" note that
# seeds her NEXT reply — plan-then-speak, on the existing single call (no extra LLM
# round-trip). Default ON; set to 0 to disable without a redeploy.
# STEP_INTENT=1
# Freshness window (seconds) before a stale intent seed is dropped (default 6h).
# STEP_INTENT_TTL_SEC=21600

# Directive-leak guard (v2026-07-29.1). The reply prompt teaches the model a
# `[selfie: ...]` output convention; a reasoning model holding private planning
# instructions can render that planning in the same bracket syntax, and extract_tags
# only removes tags it knows by name. Jules (glm-5.1:thinking) sent a selfie captioned
# with `[ATTRACTION RULE]: ...` / `[PACE CONTROL]: ...` on 2026-07-29. This drops whole
# lines that are nothing but an ALL-CAPS bracketed label and logs each one at WARNING —
# stripping alone would hide a real model fault. Lowercase asides like "[laughs]" are
# untouched. Default ON; set to 0 to disable without a redeploy.
# DIRECTIVE_LEAK_GUARD=1


# ══════════════════════════════════════════════════════════════════════════════
# Previously undocumented settings (added 2026-07-25 by the config audit)
#
# A mechanical diff of every os.getenv/_env_int/_env_float name against this file found
# 65 variables the code reads that were never documented here — while CLAUDE.md calls
# this the "full documented template". Defaults below are read from bot.py, not typed
# from memory. Everything here is optional; the default is what you get if you omit it.
# ══════════════════════════════════════════════════════════════════════════════

# --- Location & weather -------------------------------------------------------------
# WEATHER_LOCATION is the place name the character believes she's in (it appears in the
# prompt); LAT/LON drive the actual forecast lookup. Change all three together.
# WEATHER_LOCATION=Seattle
# WEATHER_LAT=47.6062
# WEATHER_LON=-122.3321

# --- Web search ---------------------------------------------------------------------
# SEARCH_ENABLED=1                  # 0 disables the [search: …] capability entirely
# SEARCH_RESULTS=4                  # results fetched per query
# LINK_MAX_CHARS=2200               # max characters pulled from a shared link

# --- Voice & delivery ---------------------------------------------------------------
# TEXTING_REALISM=1                 # 0 drops preset.txt / the texting-style block
# DEVICE_RENDER=0                   # 1 renders her bubbles in monospace, like a phone log
# TYPING_WPM=120                    # simulated typing speed for the delay before a reply
# TYPING_DELAY_MIN=0.5
# TYPING_DELAY_MAX=3.5

# --- Follow-up messages (a second bubble shortly after the first) --------------------
# FOLLOWUP_ENABLED=false            # note: this one is "true"/"false", not 1/0
# FOLLOWUP_MIN_SECS=45
# FOLLOWUP_MAX_SECS=120

# --- Documents, PDFs, images --------------------------------------------------------
# DOCUMENT_MODEL must be an INSTRUCTION model — a roleplay model performs the character
# card it is meant to be analysing (see CLAUDE.md §Models).
# DOCUMENT_MODEL=deepseek/deepseek-v4-flash
# DOCUMENT_MAX_SIZE_MB=2
# PDF_MAX_SIZE_MB=20
# PDF_MAX_CHARS=16000
# PDF_OCR_MAX_PAGES=4
# IMAGE_TIMEOUT=180                 # seconds to wait on selfie/image generation

# --- Selfies ------------------------------------------------------------------------
# SELFIE_MODEL=flux-kontext
# SELFIE_SIZE=1024x1024
# SELFIE_STEPS=28
# SELFIE_GUIDANCE=3.5

# --- Voice replies ------------------------------------------------------------------
# TTS_MODEL=tts-1
# TTS_CHANCE=0.30                   # ambient chance of a voice note (see also
#                                   # VOICE_REPLY_TO_VOICE above)

# --- Memory & notes -----------------------------------------------------------------
# MEMORY_AUTO=1                     # 0 stops automatic memory extraction
# MEMORY_AUTOCONF=7                 # 1-10; below this a memory is stored hedged, not asserted
# MEMORY_TOKEN_BUDGET=300           # tokens of recalled memories injected per reply
# MEMORIES_MAX=200                  # hard cap on memories.txt entries
# USER_NOTES_MAX=15                 # hard cap on user_notes.txt entries

# --- Mood & reactions ---------------------------------------------------------------
# MOOD_AUTO=1                       # 0 stops mood appraisal
# MOOD_LABEL_FRESH_HOURS=12         # how long an appraised mood label stays usable
# REACTIONS_AUTO=1                  # 0 stops emoji reactions

# --- Proactive timing ---------------------------------------------------------------
# AWAY_AUTO_HOURS=3                 # silence after which she treats you as away
# GAP_AWARE_HOURS=12                # gap after which a reply acknowledges the gap
# LULL_THRESHOLD=3                  # consecutive low-energy turns before she reads a lull
# OWNER_CHAT_ID=                    # normally claimed automatically by /start

# --- Schedules & housekeeping -------------------------------------------------------
# BACKUP_WEEKDAY=6                  # 0=Mon … 6=Sun, for the weekly backup job
# REMINDER_WINDOW_DAYS=6            # payment-reminder look-ahead (Thu + 6 = next Wed)
# ATLAS_SAMPLE=6                    # local places sampled into the prompt per reply

# --- Inner voice --------------------------------------------------------------------
# INNER_VOICE_MODEL=                # defaults to MOOD_MODEL when unset

# --- Group chat tuning (only meaningful with GROUP_MODE=1) --------------------------
# See GROUP_CHAT_DESIGN.md first — and note the co-location requirement: every peer must
# share ONE filesystem. Satisfied by default now that all seven instances live under
# /opt/telegram-bots/ on the VPS; would break again if a future instance were hosted
# elsewhere (verify with the OPS_MANUAL.md group-chat setup steps, don't assume).
# GROUP_ALTERNATION_PENALTY=2.0     # discourages the same bot replying twice in a row
# GROUP_CLAIM_TTL_SECONDS=600
# GROUP_LEDGER_MAX_AGE_SECONDS=600

# --- Reddit link reading (credentials) ----------------------------------------------
# Without these, a shared Reddit link fails: Reddit puts plain scraping behind a JS
# verification wall, so link reading has to go through their OAuth API. Create a free
# "script" app at https://www.reddit.com/prefs/apps and paste the id/secret here.
# Only affects Reddit URLs — every other link works via LINK_READING without any of this.
# REDDIT_CLIENT_ID=your-reddit-app-id
# REDDIT_CLIENT_SECRET=your-reddit-app-secret
# REDDIT_USER_AGENT=CompanionBot/1.0

# --- Internal knobs — NOT settings ---------------------------------------------------
# The following are read from the environment but are implementation details, listed
# here only so this file is a complete account of what bot.py reads. They are sized
# against internal buffers, file formats and API endpoints; changing them is unsupported
# and mostly a good way to break memory compaction or image generation. Deliberately
# left without example values so they aren't treated as a menu:
#
#   BOT_HOME                  set by run-bot.sh / systemd — the instance directory
#   TIMEZONE                  legacy alias; prefer BOT_TIMEZONE (which now wins)
#   ATLAS_FILE                path override for the local-places file
#   GEMINI_IMAGE_URL          API endpoint
#   NANOGPT_IMAGE_URL         API endpoint
#   BELIEF_TRAITS             self-image tracking internals
#   BELIEF_DRIFT_MAX          self-image tracking internals
#   LONG_FACTS_MAX            memory compaction thresholds — change these and
#   LONG_FACTS_TARGET         summarisation stops converging
#   RECENT_FACTS_MAX
#   RECENT_FACTS_TARGET
#   OWN_DAYS_KEPT             how many own-day entries survive rotation
#   PROMOTION_INTERVAL_DAYS   memory promotion cadence
#   RECS_MAX                  tracked recommendation outcomes
#   QUESTION_MEMORY_SIZE      anti-repeat ring buffer
#   PROACTIVE_HOOK_DEDUP_SIZE anti-repeat ring buffer
#   SELFIE_DEDUP_SIZE         anti-repeat ring buffer
