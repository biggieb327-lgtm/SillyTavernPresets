# Copy this file to .env in the same folder and fill in the values.
# Never commit your real .env to version control.

# --- Required ---

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your NanoGPT API key (https://nano-gpt.com). Confirmed on-device 2026-07-17: this
# is the SAME key value across all six instances (one NanoGPT account) — unlike
# TOMTOM_API_KEY below, which is per-bot. If an instance's .env is ever missing this
# line, copy it from any other instance's .env rather than treating it as unique.
NANOGPT_API_KEY=your-nanogpt-api-key-here

# --- Optional: API provider ---

# Base URL for the OpenAI-compatible API (default: NanoGPT)
# Change this to use a different provider (e.g. Featherless, Together, local Ollama)
# NANOGPT_BASE=https://nano-gpt.com/api/v1

# --- Optional: model settings ---

# Model to use for chat (default shown)
# NANOGPT_MODEL=zai-org/glm-5:thinking

# Model to use for rolling summaries (can be a cheaper/faster model)
# SUMMARY_MODEL=zai-org/glm-4.7-flash

# Model for emoji reactions (fast/cheap)
# REACTION_MODEL=zai-org/glm-4.7-flash

# Model for mood appraisal (fast/cheap)
# MOOD_MODEL=zai-org/glm-4.7-flash

# Model for image vision tasks. Must support image input.
# VISION_MODEL=zai-org/glm-4.6v

# Fallback model if the primary chat model fails (5xx / timeout)
# Magnum v4 72B is the recommended fallback for roleplay — strong character voice,
# good at casual texting register. Euryale v2.3 is a solid alternative.
# FALLBACK_MODEL=anthracite-org/magnum-v4-72b
# FALLBACK_MODEL=Sao10K/L3.3-70B-Euryale-v2.3

# Fallback model if the vision model fails
# VISION_FALLBACK=gpt-4o

# Max tokens per response (default 2048)
# MAX_TOKENS=2048

# Temperature (0.0 = deterministic, 1.0 = default, higher = more random)
# If unset, uses the model's default
# TEMPERATURE=1.0

# Hard cap in seconds per API request (default 120)
# REQUEST_TIMEOUT=120

# Max seconds of silence between streaming chunks before aborting (default 90)
# Lower = faster stall detection; raise if your model has long thinking pauses
# or your connection is slow/congested (many bots on one phone)
# STREAM_TIMEOUT=90

# --- Optional: performance tuning ---

# Responses are now streamed — if the model goes silent for STREAM_TIMEOUT seconds
# mid-response, the request aborts and retries (or falls back). This catches stalls
# much faster than the old 300s read timeout.

# The default chat model (glm-5:thinking) is a reasoning model — accurate but slow.
# For faster responses, switch to a non-reasoning model:
# NANOGPT_MODEL=zai-org/glm-5
# NANOGPT_MODEL=deepseek/deepseek-v4-flash

# Fallback model bounds worst-case latency. Without one, all retries hit the same
# slow model. Set to a fast model so failures recover quickly:
# FALLBACK_MODEL=anthracite-org/magnum-v4-72b

# Inner voice adds a private thought before the main reply (extra LLM round-trip).
# Disabled by default for speed. Enable for richer subtext (adds 1-5s latency):
# INNER_VOICE_ENABLED=true

# Typing delay simulates natural typing speed (0.5-3.5s after LLM returns).
# Disable for instant delivery:
# TYPING_DELAY=0

# Link reading fetches URL content before replying. Disable or shorten timeout:
# LINK_READING=false
# LINK_FETCH_TIMEOUT=8

# --- Optional: character ---

# Character card filename (must be in the bot's base directory)
# CHARACTER_CARD=nora.json

# --- Optional: selfie / image generation ---

# Which backend to use for selfie generation: "gemini" or "nanogpt"
# Defaults to "gemini" if GEMINI_API_KEY is set, otherwise "nanogpt"
# SELFIE_PROVIDER=gemini

# Google Gemini API key (for selfie generation via Gemini)
# GEMINI_API_KEY=your-gemini-key-here

# Gemini image model to use
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Reference photo filename for selfie generation (in the bot's base directory)
# SELFIE_BASE=nora_base.png

# Probability of bot sending a selfie after receiving a photo (0.0–1.0)
# PHOTO_SELFIE_CHANCE=0.20

# --- Optional: memes ---
# Template + text-overlay memes (not AI-generated — reliable, legible captions).
# Templates live in meme_templates/ and the font in fonts/, shared alongside bot.py
# (not per-instance). See /meme in Telegram, or the [meme: top | bottom] tag she can
# use in-character.

# Starting font size in points before auto-shrink-to-fit kicks in
# MEME_FONT_SIZE=80

# How many recently-used templates to avoid repeating per chat
# MEME_DEDUP_SIZE=5

# --- Optional: voice messages ---

# TTS provider is chosen automatically: if INWORLD_API_KEY is set, voice
# replies use Inworld (api.inworld.ai) with TTS_VOICE as the Inworld voice ID
# (including cloned voices). Otherwise NanoGPT's /audio/speech is used with
# TTS_MODEL/TTS_VOICE (OpenAI-style: tts-1 + alloy/echo/fable/onyx/nova/shimmer).

# Inworld runtime API key — the base64 key from the Inworld portal (Basic auth)
# INWORLD_API_KEY=your-inworld-base64-key-here

# Inworld TTS model (default inworld-tts-2)
# INWORLD_TTS_MODEL=inworld-tts-2

# Voice: Inworld voice ID when using Inworld, OpenAI voice name otherwise
# TTS_VOICE=Zadieova

# Probability of replying with voice when the user sent a voice note (0.0–1.0).
# Only applies when /voice is on. Independent of TTS_CHANCE, which governs text→voice.
# VOICE_REPLY_TO_VOICE=0.9

# Whisper model for transcribing voice messages and video audio
# WHISPER_MODEL=whisper-1

# Max video file size in MB to accept (requires ffmpeg: pkg install ffmpeg)
# VIDEO_MAX_SIZE_MB=50

# --- Optional: memory settings ---

# Embedding model for semantic memory recall (uses NanoGPT's /v1/embeddings).
# Memories are embedded on write and cached in embeddings.json; queries are embedded
# on recall and matched by cosine similarity, merged with keyword results.
# Falls back silently to keyword-only if the API is unavailable.
# EMBEDDING_MODEL=text-embedding-3-small

# How many messages to keep in the rolling context window
# CONTEXT_LIMIT=40

# Summarize conversation every N turns
# SUMMARY_EVERY=20

# Weekly memory audit loop: one cheap-model (SUMMARY_MODEL) pass over memories.txt
# proposing contradiction/superseded/stale merges and deletions into the /reviewmem
# queue. It never deletes anything itself — every proposal needs your ok, and a
# rejected proposal is never re-proposed. 0/unset = off.
# MEMORY_AUDIT=1
# MEMORY_AUDIT_WEEKDAY=6            # 0=Mon .. 6=Sun (runs with the nightly reflection job)
# MEMORY_AUDIT_MAX_PROPOSALS=3      # per weekly run

# Recency decay for memory recall ranking: exponential half-life in days. Older
# memories rank lower (floored at 0.1x, so they fade, never vanish). Entries
# without a recorded timestamp (pre-2026-07) are never down-weighted.
# 0/unset = off (today's behavior). Recommended: 90.
# MEMORY_DECAY_HALFLIFE_DAYS=90

# Repeat-injection suppression (v2026-07-18.1): memory recall re-ranks all memories
# against the recent conversation every turn, so a stable theme makes the same lines
# win the budget turn after turn and the character re-tells one memory (reworded)
# endlessly. This down-weights (never excludes) memories injected on recent turns so
# near-ties rotate; it also adds a "don't re-raise a memory you just referenced" line
# to the prompt. Default ON (6); set 0 to disable. Kill switch, not opt-in.
# MEMORY_REPEAT_SUPPRESS_TURNS=6
# MEMORY_REPEAT_PENALTY=0.15         # score x this the turn after injection, fading to 1.0

# Prefix "(unsure)" on recalled memories whose recorded confidence is below
# MEMORY_AUTOCONF, so the character hedges instead of asserting them as fact.
# For hedged memories that recorded a source snippet, the snippet is also shown
# to the model so it can self-check. 0/unset = off.
# MEMORY_HEDGE=1

# Live semantic recall (v2026-07-12.2): embed each user message once per reply so
# semantic memory recall AND semantic lorebook matching actually fire during chat
# (previously the vectors were written on every memory add but never read in a live
# reply). The embed runs off the event loop, is cached, and falls back to
# keyword-only on timeout. Default ON — set 0 to disable without a redeploy.
# MEMORY_SEMANTIC_LIVE=1
# MEMORY_QUERY_EMBED_TIMEOUT=3.0     # seconds before falling back to keyword-only
# MEMORY_DEDUP_SIM=0.92              # cosine >= this on write = near-duplicate, skipped
# MEMORY_LORE_SEMANTIC_TOPK=3        # semantic lore hits added per turn (floor 0.3)

# Max milestones to track per chat
# MILESTONES_MAX=30

# --- Privacy / access control ---

# Comma-separated list of Telegram user IDs allowed to use the bot.
# When set, ALL private-chat interaction from anyone else is silently ignored —
# commands, messages, media, buttons (enforced centrally, v2026-07-13.1). The
# owner (OWNER_CHAT_ID or the claimed owner_chat.txt) always passes even if not
# listed. Leave empty to allow anyone (not recommended for personal bots).
# Get your ID by sending /chatid to your bot.
# ALLOWED_USERS=123456789,987654321

# Minimum seconds between messages from the same user (rate limiting)
# RATE_LIMIT_SECONDS=2

# --- Proactive messages ---

# How often the bot sends unprompted check-ins (random between these, in hours)
# HEARTBEAT_MIN=2
# HEARTBEAT_MAX=6

# Max proactive messages per day (nudge budget)
# NUDGE_MAX=3

# Hour range (local time) during which proactive messages can be sent
# PROACTIVE_HOUR_START=9
# PROACTIVE_HOUR_END=21

# --- Timezone ---

# Timezone for time-aware features (reminders, proactive messages)
# Uses IANA timezone names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BOT_TIMEZONE=America/New_York

# --- Payments (optional feature) ---

# Enable payment tracking commands (/addpayment, /payments, etc.)
# PAYMENTS_ENABLED=1

# Day of week for weekly payment summary (0=Mon, 6=Sun)
# REMINDER_WEEKDAY=0

# Time for weekly payment reminder (HH:MM)
# REMINDER_TIME=09:00

# --- Admin HTTP API (VPS deployments only, opt-in) ---

# Mirrors /audit /errors /backup /update /restart over HTTP for non-Telegram clients
# (e.g. a control-panel app). Fully inert if left unset — Termux instances don't need
# this. Meant to be reached only over a private Tailscale network, never the public
# internet; see telegram-companion-bot/deploy/install-vps.sh.
# ADMIN_API_ENABLED=1

# Required if ADMIN_API_ENABLED is set — every route except GET /admin/health needs
# this as `Authorization: Bearer <token>`. install-vps.sh generates one per instance.
# ADMIN_API_TOKEN=

# Port to listen on (default 8765)
# ADMIN_API_PORT=8765

# Address to bind. Defaults to 127.0.0.1 (loopback-only, unreachable) so a
# misconfigured instance fails closed. Set to the host's Tailscale IP
# (`tailscale ip -4`) to actually expose it over the tailnet — never 0.0.0.0.
# ADMIN_API_BIND=127.0.0.1

# --- Monitoring (dead man's switch) ---

# Per-instance ping URL (e.g. from healthchecks.io, free tier). The bot GETs it
# every 30 minutes; the service alerts you when pings STOP — catching everything
# a dead bot can't self-report, including the whole phone being off.
# Create one check per bot; set the period to 30 min with ~15 min grace.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# Monthly spend budget (same unit as NanoGPT's usage API). When set, the bot
# DMs the owner at 80% and 100% of this amount (checked every 30 min, 24h cooldown).
# USAGE_BUDGET_MONTHLY=50

# --- Shared world context ---

# When set to 1, this instance generates world.txt at midnight — a shared backdrop
# (weather, ambient local happenings) that all instances read during day generation.
# Only ONE instance should have this set (typically the home instance / nora).
# WORLD_GENERATOR=1

# Path to the shared world.txt (default: alongside bot.py, i.e. ~/telegram-bot/world.txt).
# All instances read from this path; only the generator writes to it.
# WORLD_FILE=/home/user/telegram-bot/world.txt

# --- Group chat (experimental — read GROUP_CHAT_DESIGN.md before enabling) ---

# Master switch. Even when off, group chats are ignored fleet-wide (fail closed):
# no commands except /chatid, no replies, no state. Enable on the pilot pair only.
# Requires BotFather privacy mode DISABLED for this bot (then re-add it to the group).
# GROUP_MODE=1

# REQUIRED with GROUP_MODE: comma-separated group chat ids this bot may join in on.
# A group not listed here is ignored entirely. Get the id with /chatid in the group.
# GROUP_ALLOWED_CHATS=-1001234567890

# Names of the other character(s) in the group, for her group-context prompt
# GROUP_PEERS=Jules

# Optional one-line relationship note per peer ("Name: line; Name2: line")
# GROUP_PEER_NOTES=Jules: a friend you know through Brian; you find her funny

# Chance of replying to a peer bot's unaddressed message (0.0-1.0, default 0.35)
# GROUP_BOT_REPLY_PROB=0.35

# Max consecutive bot messages since the last human one (default 2). The loop cap.
# GROUP_BOT_CHAIN_MAX=2

# Ledger poll cadence in seconds (default 5) — how fast she hears the other bot
# GROUP_POLL_SECONDS=5

# Min seconds between her own group messages (default 20)
# GROUP_MIN_GAP_SECONDS=20

# Max bot-to-bot replies per day (default 30). Human-addressed replies are unaffected.
# GROUP_DAILY_BOT_BUDGET=30

# Shared dir for the group ledger + claim files (default: alongside bot.py).
# All participating instances must point at the SAME directory.
# GROUP_LEDGER_DIR=/data/data/com.termux/files/home/telegram-bot

# --- Scheduled jobs ---

# Time for weekly backup (HH:MM)
# BACKUP_TIME=03:00

# Time for nightly reflection (HH:MM)
# REFLECTION_TIME=02:00

# Time of day to follow up on dated user notes, e.g. "interview Tuesday" ->
# she asks how it went that evening (HH:MM; respects quiet hours + nudge budget)
# NOTE_FOLLOWUP_TIME=18:00

# Recurring events mentioned in conversation ("derby every Thursday") get an
# (every …) marker and re-fire naturally at each occurrence instead of once.
# Kill switch: set to 0 to capture them as one-off notes like before (default 1)
# NOTE_RECURRING=1

# Reject user notes not backed by a verbatim quote from the user's own messages —
# blocks the character's roleplay/scene lines from becoming "facts" about the user.
# Set to 0 to store notes ungrounded like before (default 1)
# NOTE_GROUNDED=1

# Days a retired "(asked …)" note stays in the file before the daily follow-up
# job prunes it. 0 = keep forever (old behavior). Default 7
# NOTE_ASKED_TTL_DAYS=7

# Word-overlap threshold (0-1) for treating a new note as a duplicate of an
# existing one ("2pm call with Yuen" vs "call with Yuen in eight minutes").
# 0 = prefix-only dedup (old behavior). Default 0.8
# NOTE_DEDUP_SIM=0.8

# --- WSDOT Traffic (Western Washington) ---

# WSDOT Traveler Information API access code (free at wsdot.wa.gov/traffic/api)
# When set, enables /traffic, /incidents, live location alerts, and 10-min polling
# WSDOT_API_KEY=your-access-code-here

# Radius in miles for location-based incident alerts (default 10)
# TRAFFIC_RADIUS_MILES=10

# How often to poll for new nearby incidents when live location is active (minutes)
# TRAFFIC_POLL_MINUTES=10

# --- TomTom Maps (routing + place/POI search; Nora, Emily, Priya) ---

# Free API key from https://developer.tomtom.com (enable Search + Routing APIs).
# When set, enables /route, /nearby, /place. Unset = those commands are disabled
# (fail-closed). The MCP TomTom connector in Claude sessions does NOT provide this;
# each bot needs its own key here.
# TOMTOM_API_KEY=your-tomtom-key-here

# Default travel mode for /route: car | bicycle | pedestrian (also truck/taxi/bus/
# van/motorcycle). Recommended per character: Nora=bicycle, Emily=car, Priya=pedestrian.
# Invalid values log a [tomtom] warning and fall back to car.
# TOMTOM_TRAVEL_MODE=car

# In-character restaurant recs (needs TOMTOM_API_KEY). When on: if the user asks
# about food and has shared their location, real nearby restaurants are handed to
# the model so it recommends them in character (no extra AI call). Off = today's
# behavior. Enable per character you want it on (e.g. Nora/Emily/Priya).
# FOOD_SUGGESTIONS=1

# Generalized map intent (needs TOMTOM_API_KEY; independent of FOOD_SUGGESTIONS).
# When on: an explicit map-shaped ask — "how do I get to X", "how far is X",
# "is there a <thing> nearby", "closest <thing>" — pre-fetches a real TomTom
# route or place list into the same single reply, so times/distances/places come
# from the map, not imagination (no extra AI call). Route origin is the user's
# shared location (fresh within 4h or live); without one she asks for a pin.
# Off/unset = today's behavior exactly. Enable per TomTom-keyed character.
# MAP_INTENT=1

# --- R6 Evolution experiments (default off, pilot one instance at a time) ---

# 👍/👎 reactions on bot messages → mood nudge + feedback log + recalibration note
# FEEDBACK_REACTIONS=1

# Derived relationship-depth score shown in /status + injected as system context
# CLOSENESS_ENABLED=1

# Multi-thread next_goals (str → list of 3); updated via post_reply_analysis
# THREADS_ENABLED=1

# Auto-detect inside-joke candidates and queue them for /reviewmem curation
# JOKE_CANDIDATES=1
